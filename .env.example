# ---------------------------------------------------------------------------
# ملف متغيرات البيئة (مثال). انسخ هذا الملف باسم .env وعدّل القيم حسب حاجتك.
# ---------------------------------------------------------------------------

# هل نستخدم OpenAI فعليًا لاتخاذ القرار؟ اجعلها false لتجربة المشروع
# فورًا دون أي مفتاح API (وضع القواعد Rule-Based Mode).
USE_OPENAI=false

# مفتاح OpenAI API الخاص بك (مطلوب فقط إذا كانت USE_OPENAI=true)
OPENAI_API_KEY=ضع_المفتاح_هنا

# اسم نموذج OpenAI المستخدم عند تفعيل USE_OPENAI
OPENAI_MODEL=gpt-4.1-mini

# رابط الاتصال بقاعدة البيانات (SQLite افتراضيًا، لا حاجة لتغييره للتجربة)
DATABASE_URL=sqlite:///./customer_service.db

# الحد الأدنى لدرجة الثقة المقبولة من نظام RAG قبل استخدام الإجابة
MIN_RAG_SCORE=0.20
